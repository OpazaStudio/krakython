# Base de données Postgres (Neon via Vercel en prod, Postgres local en dev).
# Homebrew / Postgres.app : postgres://<utilisateur Mac>@localhost:5432/krakython (sans mot de passe)
# Docker : postgres://postgres:postgres@localhost:5432/krakython
# La base est créée toute seule au premier `pnpm payload migrate`.
DATABASE_URL=postgres://postgres@localhost:5432/krakython

# Chiffrement des sessions Payload : openssl rand -hex 24
PAYLOAD_SECRET=CHANGE_ME

# URL publique du site, sans slash final (sert aussi aux retours Stripe)
NEXT_PUBLIC_SERVER_URL=http://localhost:3200

# Stockage des images (Vercel Blob, store en accès Public). Vide = fichiers dans public/media
BLOB_READ_WRITE_TOKEN=

# Stripe (boutique). Clé restreinte rk_ de préférence, sinon sk_. Mode test : *_test_*
STRIPE_SECRET_KEY=
# Secret du endpoint webhook : Dashboard Stripe → Webhooks, ou `stripe listen --forward-to localhost:3200/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# E-mails (Resend) : commandes, messages, et le « mot de passe oublié » de l'admin.
# Sans clé : en dev l'envoi est simulé dans la console. En prod, la réinitialisation
# du mot de passe admin ne part pas et le lien est perdu : la clé est indispensable.
RESEND_API_KEY=
# Expéditeur : adresse d'un domaine vérifié dans Resend (ex. "Krakython <boutique@krakython.fr>")
EMAIL_FROM=
# Boîte de l'asso qui reçoit les notifications de commande (sinon : l'e-mail de contact des Réglages)
EMAIL_ASSO=

# Compte admin créé par le seed. SEED_ADMIN_PASSWORD est obligatoire (aucune valeur
# par défaut) : un mot de passe fort, différent en local et en production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
